{
  "redirects": [
    {
      "source": "/brochureVI",
      "destination": "/brochure",
      "permanent": true
    },
    {
      "source": "/brochureVI/(.*)",
      "destination": "/brochure/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/brochure",
      "destination": "/brochure/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
