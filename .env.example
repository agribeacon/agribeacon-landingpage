# Server-only key for the /api/chat Vercel function.
# Do not expose this as a VITE_* variable.
OPENCODE_GO_API_KEY=

# Optional. Defaults to deepseek-v4-flash.
OPENCODE_GO_MODEL=deepseek-v4-flash

# Server-only AWS credentials for the /api/hero-video presigned URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server-only Discord webhook for the /api/order quote requests.
# Do not expose this as a VITE_* variable.
DISCORD_WEBHOOK_URL=
