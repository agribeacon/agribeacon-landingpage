# Server-only key for the /api/chat Vercel function.
# Do not expose this as a VITE_* variable.
OPENCODE_GO_API_KEY=

# Optional. Defaults to deepseek-v4-flash.
OPENCODE_GO_MODEL=deepseek-v4-flash

# Server-only AWS credentials for the /api/hero-video presigned URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server-only Discord webhook for the /api/order quote requests.
# Do not expose this as a VITE_* variable.
DISCORD_WEBHOOK_URL=

# Server-only: where the /api/contact function sends contact-form leads (AgriBeacon CRM).
# Do not expose these as VITE_* variables.
# Staging: https://api.super-admin-2.the8seven.site  Production: https://api.internal.agribeacon.tech
CRM_API_URL=
CRM_API_KEY=

# Public base URL of sutagrow-api (used by the Help Center pages).
# Dev: http://localhost:3018/api  Staging: https://farm-dev-be.agribeacon.tech/api
VITE_API_URL=http://localhost:3018/api
